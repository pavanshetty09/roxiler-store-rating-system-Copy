@'
# Dependencies
**/node_modules/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Build files
**/dist/
**/build/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Generated files
server/src/generated/prisma/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding utf8 .gitignore